site/node_modules

# One PDF per lesson (528 files, ~160 MB) is generated by site/build-pdf.mjs.
# Only the merged booklets are kept in the repository — they hold the same
# pages, one file per grade, stream and quarter.
site/pdf/g*-*-q*-*.pdf

# Python bytecode from the lesson build scripts.
__pycache__/

# The archive of the Grade 8 track is built on demand, not kept in the repo.
olympiad-g8-*.zip
