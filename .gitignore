site/node_modules

# One PDF per lesson (528 files, ~160 MB) is generated by site/build-pdf.mjs.
# Only the merged booklets are kept in the repository — they hold the same
# pages, one file per grade, stream and quarter.
site/pdf/g*-*-q*-*.pdf

# The student login lists extract-edupage-logins.py writes out of the EduPage
# parent-letter PDFs. They hold usernames and passwords, so they are generated
# when needed and kept out of the repository:
#   python3 extract-edupage-logins.py "Ellipse International School edupage3.pdf" \
#       --grade 8 --xlsx Grade8_EduPage_Logins.xlsx
*_EduPage_Logins.csv
*_EduPage_Logins.xlsx

# The printable mark sheets make-mark-sheets.py writes. They carry the class
# rolls, and they are generated, so they stay out of the repository:
#   python3 make-mark-sheets.py "Ellipse International School edupage3.pdf" --grade 8
mark-sheets/

# Byte-code left behind when make-mark-sheets.py imports the extractor.
__pycache__/

# The workbook build output. The question bank and the builders are tracked;
# the rendered book is generated:
#   cd workbooks && ./build-all.sh
workbooks/*.html
workbooks/*.pdf
workbooks/out/

# The title sidecar the workbook builder writes for the PDF footer.
workbooks/*.title
